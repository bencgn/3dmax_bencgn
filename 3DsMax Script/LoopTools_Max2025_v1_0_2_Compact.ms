rollout LTM_GStretchUI "Gstretch / Spline guide" width:248 height:166
(
    pickButton pbGuide "Pick spline guide" filter:LTM_GuideFilter autoDisplay:true pos:[6,6] width:182 height:24
    button btClear "Clear" pos:[194,6] width:46 height:24
    label lbMethod "Method:" pos:[6,43] width:48 height:16
    dropdownList ddMethod "" items:#("Spread evenly", "Spread / preserve ratios", "Project intersections") selection:1 pos:[58,38] width:182
    spinner spSamples "Guide samples:" range:[32,2048,256] type:#integer fieldWidth:65 pos:[6,72] width:234 height:18
    label lb "No guide = straighten open chain.\nClosed loop: use a closed guide.\nNo Blender GP convert / delete." pos:[6,106] width:234 height:46
    on pbGuide picked obj do
    (
        LTM_GuideNode = obj
        LTM_Status ("Guide: " + obj.name + ". Return to your Editable Poly selection, then click Gstretch.")
    )
    on btClear pressed do
    (
        LTM_GuideNode = undefined
        pbGuide.text = "Pick spline guide"
        LTM_Status "Guide cleared. Gstretch will straighten an open chain."
    )
)

rollout LTM_UI "LoopTools 2025 | v1.0.2" width:280 height:300
(
    local optionPanels = #()
    local optionRollouts = #()
    -- One living settings rollout per container. Switching never destroys controls,
    -- so hidden option values remain available to the UNCHANGED LTM_CollectOptions.
    -- Order: Circle, Flatten, Relax, Space, Curve, Gstretch, Bridge/Loft.
    local optionHeights = #(166,100,140,96,174,194,226)

    label lbHeader "LOOPTOOLS  /  EDITABLE POLY" pos:[8,8] width:232 height:16
    button btHelp "?" pos:[248,4] width:24 height:22 toolTip:"Help, limitations and license."
    button btCircle "Circle" pos:[8,30] width:129 height:28 toolTip:"Click: round a loop. Right-click: Circle options."
    button btFlatten "Flatten" pos:[143,30] width:129 height:28 toolTip:"Click: flatten selection. Right-click: Flatten options."
    button btRelax "Relax" pos:[8,62] width:129 height:28 toolTip:"Click: relax loop. Right-click: Relax options."
    button btSpace "Space" pos:[143,62] width:129 height:28 toolTip:"Click: space vertices. Right-click: Space options."
    button btCurve "Curve" pos:[8,94] width:129 height:28 toolTip:"Click: curve from sparse controls; non-controls can move. Right-click: options."
    button btGStretch "Gstretch" pos:[143,94] width:129 height:28 toolTip:"Click: use spline guide (or straighten). Right-click: guide and options."
    button btBridge "Bridge" pos:[8,126] width:129 height:28 toolTip:"Click: bridge selected borders / regions. Right-click: Bridge / Loft options."
    button btLoft "Loft" pos:[143,126] width:129 height:28 toolTip:"Click: loft multiple sections. Right-click: Bridge / Loft options."

    spinner spInfluence "Influence %:" range:[0,100,100] type:#float scale:1 fieldWidth:48 pos:[8,166] width:136 height:18
    label lbLocks "Lock:" pos:[154,168] width:34 height:16
    checkBox ckX "X" checked:false pos:[190,167] width:27 height:18
    checkBox ckY "Y" checked:false pos:[217,167] width:27 height:18
    checkBox ckZ "Z" checked:false pos:[244,167] width:28 height:18

    button btStraighten "Straighten" pos:[8,194] width:84 height:24 toolTip:"Straighten an open chain with even spacing; ignores the spline guide."
    button btCopy "Poly COPY" pos:[98,194] width:84 height:24 toolTip:"Make an independent collapsed copy. Original object stays untouched."
    button btInstall "Toolbar" pos:[188,194] width:84 height:24 toolTip:"Install / update this version and register its toolbar action."
    checkbutton ckOptions "Options +" checked:false pos:[8,226] width:92 height:22 toolTip:"Show / hide settings without resetting their values."
    dropdownList ddOptions "" items:#("Circle", "Flatten", "Relax", "Space", "Curve", "Gstretch", "Bridge / Loft") selection:1 pos:[106,226] width:166 toolTip:"Choose settings only; this does not run a geometry operation."

    subRollout srCircle pos:[6,254] width:268 height:166 visible:false
    subRollout srFlatten pos:[6,254] width:268 height:100 visible:false
    subRollout srRelax pos:[6,254] width:268 height:140 visible:false
    subRollout srSpace pos:[6,254] width:268 height:96 visible:false
    subRollout srCurve pos:[6,254] width:268 height:174 visible:false
    subRollout srGStretch pos:[6,254] width:268 height:194 visible:false
    subRollout srBridge pos:[6,254] width:268 height:226 visible:false
    editText txtStatus "" text:"Ready. Select Editable Poly components." pos:[8,254] width:264 height:38 readOnly:true

    fn layoutOptions =
    (
        if optionPanels.count != 7 do return false
        local selectedIndex = ddOptions.selection
        if selectedIndex < 1 or selectedIndex > 7 do selectedIndex = 1
        local extraHeight = 0
        for panel in optionPanels do panel.visible = false
        if ckOptions.checked do
        (
            local activeRollout = optionRollouts[selectedIndex]
            local activePanel = optionPanels[selectedIndex]
            activeRollout.open = true
            activePanel.visible = true
            extraHeight = optionHeights[selectedIndex] + 6
        )
        ckOptions.text = if ckOptions.checked then "Options -" else "Options +"
        txtStatus.pos = [8,254 + extraHeight]
        LTM_UI.height = 300 + extraHeight
        true
    )

    fn selectOptions selectedIndex openPanel:false =
    (
        ddOptions.selection = selectedIndex
        if openPanel do ckOptions.checked = true
        layoutOptions()
    )

    -- Left-click retains the original one-click operations. Right-click opens
    -- options only: it must NEVER move vertices or start an Undo transaction.
    on btCircle pressed do (selectOptions 1; LTM_Run "circle")
    on btFlatten pressed do (selectOptions 2; LTM_Run "flatten")
    on btRelax pressed do (selectOptions 3; LTM_Run "relax")
    on btSpace pressed do (selectOptions 4; LTM_Run "space")
    on btCurve pressed do (selectOptions 5; LTM_Run "curve")
    on btGStretch pressed do (selectOptions 6; LTM_Run "gstretch")
    on btBridge pressed do (selectOptions 7; LTM_Run "bridge")
    on btLoft pressed do (selectOptions 7; LTM_Run "loft")
    on btCircle rightclick do selectOptions 1 openPanel:true
    on btFlatten rightclick do selectOptions 2 openPanel:true
    on btRelax rightclick do selectOptions 3 openPanel:true
    on btSpace rightclick do selectOptions 4 openPanel:true
    on btCurve rightclick do selectOptions 5 openPanel:true
    on btGStretch rightclick do selectOptions 6 openPanel:true
    on btBridge rightclick do selectOptions 7 openPanel:true
    on btLoft rightclick do selectOptions 7 openPanel:true
    on ckOptions changed state do layoutOptions()
    on ddOptions selected selectedIndex do selectOptions selectedIndex openPanel:true
    on btStraighten pressed do LTM_Run "straighten"
    on btCopy pressed do LTM_MakePolyCopy()
    on btInstall pressed do LTM_InstallToolbar()
    on btHelp pressed do
        messageBox "LoopTools Max 2025 v1.0.2 - Compact UI\n\n1. Select ONE Editable Poly base object.\n2. Enter Vertex / Edge / Border / Polygon mode.\n3. Select components; LEFT-click a tool to run.\n4. RIGHT-click a tool to open its options only.\n   Or use Options + and the adjacent dropdown.\n5. Options - folds the panel back to compact size.\n\nOptions keep their values when hidden or switched.\nCtrl+Z undoes an operation. No live preview.\nCurve: sparse controls; non-control vertices can move.\nGstretch: pick a spline guide; no guide straightens.\nBridge / Loft ignore Influence and local-axis locks.\nPoly COPY keeps the original object.\nToolbar installs / updates the toolbar action.\n\nBased on Blender LoopTools 4.7.7. GPL-2.0-or-later.\nAuthors: Bart Crouch, Vladimir Spivak and contributors.\nNot every Blender feature is reproduced. See README_VI.txt.\nUI has not been runtime-tested in 3ds Max 2025." title:"LoopTools | Compact UI"

    on LTM_UI open do
    (
        optionPanels = #(srCircle, srFlatten, srRelax, srSpace, srCurve, srGStretch, srBridge)
        optionRollouts = #(LTM_CircleUI, LTM_FlattenUI, LTM_RelaxUI, LTM_SpaceUI, LTM_CurveUI, LTM_GStretchUI, LTM_BridgeUI)
        addSubRollout srCircle LTM_CircleUI rolledUp:false
        addSubRollout srFlatten LTM_FlattenUI rolledUp:false
        addSubRollout srRelax LTM_RelaxUI rolledUp:false
        addSubRollout srSpace LTM_SpaceUI rolledUp:false
        addSubRollout srCurve LTM_CurveUI rolledUp:false
        addSubRollout srGStretch LTM_GStretchUI rolledUp:false
        addSubRollout srBridge LTM_BridgeUI rolledUp:false
        ckOptions.checked = false
        layoutOptions()
        if not LTM_EngineLoaded do LTM_Status "ERROR: Python engine failed to load. Open Listener (F11)."
    )
    on LTM_UI close do
    (
        LTM_GuideNode = undefined
        LTM_RawData = #()
        LTM_GuideData = #()
    )
)
-- Keep a visible starting position rather than reusing stale/off-screen coordinates.
createDialog LTM_UI width:280 height:300 pos:[120,60] style:#(#style_titlebar,#style_sysmenu,#style_toolwindow)
