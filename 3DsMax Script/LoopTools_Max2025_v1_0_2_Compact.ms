-- SPDX-License-Identifier: GPL-2.0-or-later
-- Native MAXScript UI / scene adapter, 2026-09-15.
-- Geometry is calculated before opening theHold; scene writes are transactional.
global LTM_UI, LTM_CircleUI, LTM_BridgeUI, LTM_CurveUI, LTM_FlattenUI
global LTM_RelaxUI, LTM_SpaceUI, LTM_GStretchUI
global LTM_Busy = false
global LTM_GuideNode = undefined
global LTM_RawData = #(), LTM_Options = #(), LTM_GuideData = #()
global LTM_Action = "", LTM_Level = 0, LTM_ViewNormal = [0,0,1]
global LTM_Ready = false, LTM_Error = "", LTM_Note = ""
global LTM_MoveIDs = #(), LTM_MovePositions = #()
global LTM_NewVertices = #(), LTM_NewFaces = #(), LTM_DeleteFaces = #()
global LTM_MaterialID = 1, LTM_Smoothing = 0
try (destroyDialog LTM_UI) catch ()

fn LTM_Status text =
(
    try (LTM_UI.txtStatus.text = text) catch ()
    format "[LoopTools] %\n" text
)

fn LTM_GuideFilter obj =
(
    (isValidNode obj) and ((superClassOf obj) == Shape)
)

fn LTM_Target =
(
    if selection.count != 1 do throw "Select exactly ONE Editable Poly object."
    local obj = selection[1]
    if not isValidNode obj do throw "The selected object is not valid."
    if (classOf obj.baseObject) != Editable_Poly do
        throw "Requires Editable Poly (base object). Use Poly COPY to preserve the original."
    if obj.modifiers.count > 0 do
    (
        local current = modPanel.getCurrentObject()
        if current != obj.baseObject do
            throw "Select Editable Poly at the bottom of the modifier stack, not an Edit Poly modifier."
    )
    if (polyop.GetHasDeadStructs obj.baseObject) != 0 do
        throw "This poly has dead components. Clean a COPY of it before using LoopTools."
    obj
)

fn LTM_ReadMesh obj level =
(
    local p = obj.baseObject
    local vs = #{}, es = #{}, fs = #{}
    local vh = polyop.getHiddenVerts p
    local fh = polyop.getHiddenFaces p
    case level of
    (
        1: (vs = (polyop.getVertSelection p) - vh)
        2: (es = polyop.getEdgeSelection p)
        3: (es = polyop.getEdgeSelection p)
        4: (fs = (polyop.getFaceSelection p) - fh)
        5: (fs = (polyop.getFaceSelection p) - fh)
        default: (throw "Enter Vertex / Edge / Border / Polygon / Element sub-object mode first.")
    )
    local nv = polyop.getNumVerts p
    local nf = polyop.getNumFaces p
    if nv == 0 or nf == 0 do throw "The selected poly has no usable surface geometry."
    -- Without node:, polyop reads local coordinates from this base object.
    local points = polyop.getVerts p #all
    local edges = polyop.getEdgesVerts p #all
    local faces = for f = 1 to nf collect (polyop.getFaceVerts p f)
    local materials = for f = 1 to nf collect (polyop.getFaceMatID p f)
    local smooth = for f = 1 to nf collect (polyop.getFaceSmoothGroup p f)
    #(points, edges, faces, (vs as array), (es as array), (fs as array),
      (vh as array), (fh as array), materials, smooth)
)

fn LTM_SampleGuide guide obj sampleCount =
(
    local data = #()
    if not isValidNode guide do return data
    if not LTM_GuideFilter guide do throw "The guide must be a Line / Spline Shape."
    local inverseTM = inverse obj.objectTransform
    local count = numSplines guide
    for s = 1 to count do
    (
        if (numSegments guide s) > 0 do
        (
            local closed = isClosed guide s
            local points = #()
            -- pathParam:false uses normalized length. Sampling remains an
            -- approximation of a Bezier spline; raise Samples for sharp bends.
            for i = 0 to sampleCount do
            (
                local t = (i as float) / sampleCount
                local worldPoint = in coordsys world (interpCurve3D guide s t pathParam:false)
                append points (worldPoint * inverseTM)
            )
            append data #(points, closed)
        )
    )
    data
)

fn LTM_LocalViewNormal obj =
(
    local viewTM = inverse (getViewTM())
    local invObject = inverse obj.objectTransform
    local originLocal = [0,0,0] * invObject
    local rightLocal = (viewTM.row1 * invObject) - originLocal
    local upLocal = (viewTM.row2 * invObject) - originLocal
    local n = cross rightLocal upLocal
    if (length n) < 1e-9 then [0,0,1] else normalize n
)

fn LTM_CollectOptions =
(
    #(
        #("influence", LTM_UI.spInfluence.value),
        #("lock_x", LTM_UI.ckX.checked), #("lock_y", LTM_UI.ckY.checked), #("lock_z", LTM_UI.ckZ.checked),
        #("circle_fit", (#("best","inside"))[LTM_CircleUI.ddFit.selection]),
        #("circle_flatten", LTM_CircleUI.ckFlatten.checked),
        #("circle_regular", LTM_CircleUI.ckRegular.checked),
        #("circle_custom_radius", LTM_CircleUI.ckRadius.checked),
        #("circle_radius", LTM_CircleUI.spRadius.value),
        #("circle_angle", LTM_CircleUI.spAngle.value),
        #("bridge_segments", LTM_BridgeUI.spSegments.value),
        #("bridge_interpolation", (#("cubic","linear"))[LTM_BridgeUI.ddInterpolation.selection]),
        #("bridge_strength", LTM_BridgeUI.spStrength.value),
        #("bridge_min_width", LTM_BridgeUI.spMinWidth.value),
        #("bridge_match", (#("shortest","basic"))[LTM_BridgeUI.ddMatch.selection]),
        #("bridge_remove_faces", LTM_BridgeUI.ckRemove.checked),
        #("bridge_twist", LTM_BridgeUI.spTwist.value),
        #("bridge_reverse", LTM_BridgeUI.ckReverse.checked),
        #("bridge_close_loft", LTM_BridgeUI.ckLoop.checked),
        #("curve_interpolation", (#("cubic","linear"))[LTM_CurveUI.ddInterpolation.selection]),
        #("curve_restriction", (#("none","extrude","indent"))[LTM_CurveUI.ddRestriction.selection]),
        #("curve_boundaries", LTM_CurveUI.ckBoundaries.checked),
        #("curve_regular", LTM_CurveUI.ckRegular.checked),
        #("flatten_plane", (#("best_fit","normal","view","xy","xz","yz"))[LTM_FlattenUI.ddPlane.selection]),
        #("relax_interpolation", (#("cubic","linear"))[LTM_RelaxUI.ddInterpolation.selection]),
        #("relax_iterations", LTM_RelaxUI.spIterations.value),
        #("relax_regular", LTM_RelaxUI.ckRegular.checked),
        #("relax_parallel", LTM_RelaxUI.ckParallel.checked),
        #("space_interpolation", (#("cubic","linear"))[LTM_SpaceUI.ddInterpolation.selection]),
        #("space_parallel", LTM_SpaceUI.ckParallel.checked),
        #("gstretch_method", (#("regular","irregular","project"))[LTM_GStretchUI.ddMethod.selection])
    )
)

fn LTM_Commit obj =
(
    local p = obj.baseObject
    local originalCount = LTM_RawData[1].count
    if (polyop.getNumVerts p) != originalCount do throw "Vertex count changed while preparing operation."
    if (polyop.getNumFaces p) != LTM_RawData[3].count do throw "Face count changed while preparing operation."
    if theHold.Holding() do throw "Another operation is still active. Finish it and try again."
    local changed = LTM_MoveIDs.count + LTM_NewVertices.count + LTM_NewFaces.count + LTM_DeleteFaces.count
    if changed == 0 do return false
    local accepted = false
    theHold.Begin()
    try
    (
        with redraw off
        (
            with animate off
            (
                if LTM_MoveIDs.count > 0 do
                (
                    if LTM_MoveIDs.count != LTM_MovePositions.count do throw "Position array count mismatch."
                    -- IDs were sorted in Python so bitarray iteration matches positions.
                    polyop.setVert p (LTM_MoveIDs as bitarray) LTM_MovePositions
                )
                if LTM_DeleteFaces.count > 0 do
                (
                    polyop.deleteFaces p (LTM_DeleteFaces as bitarray) delIsoVerts:false
                    if (polyop.getNumVerts p) != originalCount do
                        throw "Deleting the faces unexpectedly changed vertex indexing. Operation cancelled."
                )
                local remap = for i = 1 to originalCount collect i
                for position in LTM_NewVertices do
                (
                    local v = polyop.createVert p position
                    if v == undefined or v < 1 do throw "Max could not create a bridge vertex."
                    append remap v
                )
                local createdFaces = #{}
                for face in LTM_NewFaces do
                (
                    local ids = for i in face collect remap[i]
                    local f = polyop.createPolygon p ids
                    if f == undefined or f < 1 do
                        throw "Max rejected a bridge polygon. Check open borders, normals, Twist and Reverse."
                    createdFaces[f] = true
                )
                if createdFaces.numberSet > 0 do
                (
                    polyop.setFaceMatID p createdFaces LTM_MaterialID
                    polyop.setFaceSmoothGroup p createdFaces LTM_Smoothing add:false
                    polyop.setFaceSelection p createdFaces
                    polyop.setEdgeSelection p (polyop.getEdgesUsingFace p createdFaces)
                    polyop.setVertSelection p (polyop.getVertsUsingFace p createdFaces)
                    subObjectLevel = 4
                )
                update obj
            )
        )
        theHold.Accept ("LoopTools " + LTM_Action)
        accepted = true
    )
    catch
    (
        -- Rethrow the current exception only after cancelling the held operation.
        if not accepted do theHold.Cancel()
        redrawViews()
        throw()
    )
    redrawViews()
    true
)

fn LTM_Run actionName =
(
    if LTM_Busy do return false
    LTM_Busy = true
    local success = false
    try
    (
        if not LTM_EngineLoaded do throw "Python engine did not load. See MAXScript Listener (F11)."
        local obj = LTM_Target()
        LTM_Level = subObjectLevel
        LTM_Action = actionName
        LTM_RawData = LTM_ReadMesh obj LTM_Level
        LTM_Options = LTM_CollectOptions()
        LTM_GuideData = #()
        if actionName == "gstretch" and isValidNode LTM_GuideNode do
            LTM_GuideData = LTM_SampleGuide LTM_GuideNode obj LTM_GStretchUI.spSamples.value
        LTM_ViewNormal = LTM_LocalViewNormal obj
        LTM_Ready = false
        LTM_Error = ""
        LTM_Status ("Calculating " + actionName + "...")
        python.execute "import looptools_max2025; looptools_max2025.host_run()"
        if not LTM_Ready do
        (
            if LTM_Error == "" then throw "Python stopped unexpectedly. See Listener (F11)." else throw LTM_Error
        )
        local applied = LTM_Commit obj
        local message = if applied then
            (actionName + ": " + (LTM_MoveIDs.count as string) + " moved; " + (LTM_NewFaces.count as string) + " new faces. Ctrl+Z = Undo.")
            else (actionName + ": no change.")
        if LTM_Note != "" do message += "\n" + LTM_Note
        LTM_Status message
        success = true
    )
    catch (LTM_Status ("ERROR: " + getCurrentException()))
    LTM_RawData = #()
    LTM_GuideData = #()
    LTM_Busy = false
    success
)

fn LTM_MakePolyCopy =
(
    if LTM_Busy do return false
    local copied = undefined
    try
    (
        if selection.count != 1 do throw "Select one geometry object to make a Poly COPY."
        local original = selection[1]
        if (superClassOf original) != GeometryClass do throw "Poly COPY requires a geometry object."
        if theHold.Holding() do throw "Finish the active operation first."
        theHold.Begin()
        try
        (
            with redraw off
            (
                copied = copy original
                copied.name = uniqueName (original.name + "_LoopTools_")
                convertToPoly copied
                select copied
                max modify mode
                modPanel.setCurrentObject copied.baseObject
                subObjectLevel = 1
            )
            theHold.Accept "LoopTools Poly COPY"
        )
        catch
        (
            -- Rethrow the current exception only after cancelling the held operation.
            theHold.Cancel()
            throw()
        )
        redrawViews()
        LTM_Status ("Created " + copied.name + ". Original kept at the same location; hide it manually to avoid overlap.")
    )
    catch (LTM_Status ("ERROR: " + getCurrentException()))
    copied
)

fn LTM_InstallToolbar =
(
    local stream = undefined
    try
    (
        if LTM_SourcePath == undefined or not doesFileExist LTM_SourcePath do
            throw "Run the saved LoopTools_Max2025.ms file before installing the toolbar action."
        local folder = (getDir #userScripts) + "\\LoopToolsMax2025\\"
        makeDir folder all:true
        local target = folder + "LoopTools_Max2025.ms"
        if (toLower LTM_SourcePath) != (toLower target) do
        (
            -- Replace only this tool's own installed script, not arbitrary files.
            if doesFileExist target do
            (
                local backup = target + ".previous"
                if doesFileExist backup do deleteFile backup
                if not copyFile target backup do throw "Could not back up the previous tool version."
                if not deleteFile target do throw "Could not replace the installed LoopTools script."
            )
            if not copyFile LTM_SourcePath target do throw "Could not copy the script to userScripts."
        )
        local macroFile = (getDir #userMacros) + "\\LoopToolsMax2025_Open.mcr"
        stream = createFile macroFile
        if stream == undefined do throw "Cannot write the toolbar macro to userMacros."
        format "macroScript LoopToolsMax2025_Open\ncategory:\"LoopTools Max 2025\"\nbuttonText:\"LoopTools\"\ntoolTip:\"LoopTools Max 2025\"\n(\n    on execute do\n    (\n        fileIn ((getDir #userScripts) + \"\\\\LoopToolsMax2025\\\\LoopTools_Max2025.ms\")\n    )\n)\n" to:stream
        close stream
        stream = undefined
        fileIn macroFile
        LTM_Status "Installed. Customize User Interface > Toolbars > Category: LoopTools Max 2025. Drag LoopTools onto a toolbar."
    )
    catch
    (
        if stream != undefined do close stream
        LTM_Status ("INSTALL ERROR: " + getCurrentException())
    )
)

-- v1.0.2: compact native settings. Names, ranges and defaults are preserved.
rollout LTM_CircleUI "Circle settings" width:248 height:138
(
    label lbFit "Fit:" pos:[6,9] width:38 height:16
    dropdownList ddFit "" items:#("Best fit", "Fit inside") selection:1 pos:[50,4] width:190
    checkBox ckFlatten "Flatten circle" checked:true pos:[6,34] width:114 height:18
    checkBox ckRegular "Even spacing" checked:true pos:[126,34] width:114 height:18
    checkBox ckRadius "Custom radius" checked:false pos:[6,62] width:114 height:18
    spinner spRadius "" range:[0.000001,10000000,1] type:#float scale:0.1 fieldWidth:85 pos:[126,61] width:114 height:18 enabled:false toolTip:"Custom radius in object-local units."
    spinner spAngle "Angle:" range:[-360,360,0] type:#float scale:1 fieldWidth:85 pos:[6,90] width:234 height:18
    label lb "Radius / locks: object-local units." pos:[6,116] width:234 height:16
    on ckRadius changed state do spRadius.enabled = state
)
rollout LTM_BridgeUI "Bridge / Loft settings" width:248 height:198
